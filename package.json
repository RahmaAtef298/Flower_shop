{
  "name": "flower-shop-dashboard",
  "version": "1.0.0",
  "description": "AI-powered sales dashboard for ERPNext, built with Vue 3, Express and Claude",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node --watch --env-file=.env.local server/index.js",
    "dev:all": "concurrently -n server,vite -c magenta,cyan \"npm:server\" \"npm:dev\"",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "chart.js": "^4.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "http-proxy-middleware": "^3.0.10",
    "vue": "^3.5.44",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^9.2.5",
    "vite": "^8.3.5"
  }
}
